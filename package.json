{
  "name": "together-game",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Two-player co-op: drive an off-road camper through the wilderness and rescue animals along the way.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "dev": "node scripts/build.mjs --watch & node --watch server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "planck": "^1.5.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
